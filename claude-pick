#!/usr/bin/env bash
# claude-pick — pick any model your provider offers, then launch Claude Code with it.
# Usage: claude-pick [provider] [extra claude args...]
#   provider: nvidia_nim, open_router, lmstudio, ollama, groq, gemini, ... (default: MODEL's in .env)
# The proxy must be running; it lists the provider's models with your configured key.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${CLAUDE_PICK_ENV_FILE:-$SCRIPT_DIR/.env}"
BASE_URL="http://localhost:${CLAUDE_PICK_PORT:-8082}"

read_env_value() {
    local key="$1"
    [[ -f "$ENV_FILE" ]] || return 0

    local raw
    raw="$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "$ENV_FILE" | tail -n 1 || true)"
    raw="${raw#*=}"
    raw="${raw%%#*}"
    raw="$(echo "$raw" | xargs || true)"
    raw="${raw%\"}"
    raw="${raw#\"}"
    raw="${raw%\'}"
    raw="${raw#\'}"
    echo "$raw"
}

for cmd in curl fzf python3 claude; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "Error: $cmd is required." >&2
        exit 1
    fi
done

provider="${CLAUDE_PICK_PROVIDER:-}"
if [[ $# -gt 0 && "$1" != -* ]]; then
    provider="$1"
    shift
fi
if [[ -z "$provider" ]]; then
    default_model="${MODEL:-$(read_env_value MODEL)}"
    provider="${default_model%%/*}"
fi
provider="${provider:-nvidia_nim}"

token="${PROXY_AUTH_TOKEN:-$(read_env_value PROXY_AUTH_TOKEN)}"
token="${token:-freecc}"

if ! response="$(curl -sS --fail-with-body -H "x-api-key: $token" \
    "$BASE_URL/v1/models?catalog=$provider")"; then
    echo "Error: could not list '$provider' models from the proxy at $BASE_URL." >&2
    echo "Is the proxy running, and is the provider's API key set in .env? ${response:-}" >&2
    exit 1
fi

model="$(python3 -c '
import json, sys
for m in json.load(sys.stdin)["data"]:
    print(m["display_name"])
' <<< "$response" | fzf --prompt="$provider model> " --height=40% --reverse || true)"

if [[ -z "$model" ]]; then
    echo "No model selected." >&2
    exit 1
fi

echo "Launching Claude with $model" >&2
ANTHROPIC_AUTH_TOKEN="$token" ANTHROPIC_BASE_URL="$BASE_URL" \
    exec claude --model "claude-fcc/$model" "$@"
