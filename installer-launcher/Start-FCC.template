@echo off
setlocal EnableExtensions

title Free Claude Code Launcher

echo.
echo ==========================================
echo          STARTING FREE CLAUDE CODE
echo ==========================================
echo.

:: ============================================================
:: Resolve project path explicitly
:: ============================================================

set "LAUNCHER_DIR=%~dp0"

for %%I in ("%LAUNCHER_DIR%..") do (
    set "PROJECT_DIR=%%~fI"
)

echo Launcher directory:
echo   %LAUNCHER_DIR%
echo.

echo Project directory:
echo   %PROJECT_DIR%
echo.

:: ============================================================
:: Find Git Bash
:: ============================================================

set "GIT_BASH="

if exist "%ProgramFiles%\Git\git-bash.exe" (
    set "GIT_BASH=%ProgramFiles%\Git\git-bash.exe"
)

if not defined GIT_BASH if exist "%ProgramFiles(x86)%\Git\git-bash.exe" (
    set "GIT_BASH=%ProgramFiles(x86)%\Git\git-bash.exe"
)

if not defined GIT_BASH (
    for /f "delims=" %%G in ('where git 2^>nul') do (
        if not defined GIT_EXE (
            set "GIT_EXE=%%G"
        )
    )
)

if not defined GIT_BASH if defined GIT_EXE (
    for %%I in ("%GIT_EXE%") do (
        set "GIT_CMD_DIR=%%~dpI"
    )

    for %%I in ("%GIT_CMD_DIR%..") do (
        set "GIT_ROOT=%%~fI"
    )

    if exist "%GIT_ROOT%\git-bash.exe" (
        set "GIT_BASH=%GIT_ROOT%\git-bash.exe"
    )
)

if not defined GIT_BASH (
    echo [ERROR] Git Bash was not found.
    echo.
    echo Please install Git for Windows.
    echo.
    pause
    exit /b 1
)

echo Git Bash:
echo   %GIT_BASH%
echo.

:: ============================================================
:: Check FCC files
:: ============================================================

if not exist "%PROJECT_DIR%\.venv\Scripts\fcc-server.exe" (
    echo [ERROR] fcc-server.exe not found.
    echo.
    echo Expected:
    echo   %PROJECT_DIR%\.venv\Scripts\fcc-server.exe
    echo.
    pause
    exit /b 1
)

if not exist "%PROJECT_DIR%\.venv\Scripts\fcc-claude.exe" (
    echo [ERROR] fcc-claude.exe not found.
    echo.
    echo Expected:
    echo   %PROJECT_DIR%\.venv\Scripts\fcc-claude.exe
    echo.
    pause
    exit /b 1
)

echo [OK] FCC files found.
echo.

:: ============================================================
:: Start FCC Server
:: ============================================================

echo Starting FCC Server...
echo.

start "FCC Server" "%GIT_BASH%" -c "cd \"$(cygpath -u '%PROJECT_DIR%')\" && ./.venv/Scripts/fcc-server.exe; echo; echo FCC Server stopped.; read -p 'Press Enter to close...'"

timeout /t 4 /nobreak >nul

:: ============================================================
:: Start FCC Claude
:: ============================================================

echo Starting FCC Claude...
echo.

start "FCC Claude" "%GIT_BASH%" -c "cd \"$(cygpath -u '%PROJECT_DIR%')\" && ./.venv/Scripts/fcc-claude.exe; echo; echo FCC Claude stopped.; read -p 'Press Enter to close...'"

echo.
echo ==========================================
echo       FCC LAUNCH COMMANDS SENT
echo ==========================================
echo.

exit /b 0